{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/managers",
      "destination": "/employees",
      "permanent": true
    },
    {
      "source": "/managers/(.*)",
      "destination": "/employees",
      "permanent": true
    }
  ]
}
